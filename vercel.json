{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/digest/route.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "schedules": {
    "morning-summary": {
      "schedule": "0 7 * * 1-5",
      "timezone": "America/Chicago",
      "function": "api/digest"
    }
  }
}
