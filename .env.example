# Copy this file to .env.local for your own computer.
# On Vercel, enter the same names in Project Settings → Environment Variables.
# Never commit the filled-in file. This repository is public.

# mock = sample data, no Google account required (the default when these are blank)
# sheets = read and write the real MV Staff Hub spreadsheet
DATA_MODE=mock

# mock = pick a sample person on the sign-in page
# google = Google sign-in for @mtvernon.church only
AUTH_MODE=mock

# A long random string. On your computer you can leave this blank.
# On Vercel, generate one (any password manager, or `openssl rand -base64 32`) and paste it here.
AUTH_SECRET=

# From the Google Cloud OAuth client. Leave blank in mock mode.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local preview uses the first line. Production uses your real site address.
AUTH_URL=http://localhost:3000

# Service account. Use ONE of these styles:
# 1. Paste the whole JSON key on a single line (or base64 of that JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2. Or paste the email and the private key separately. Keep the quotes if the key has line breaks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The long id in the spreadsheet URL, between /d/ and /edit.
# Spreadsheet name: MV Staff Hub (App Data)
GOOGLE_SHEET_ID=

# Sign-in is limited to this Workspace domain, and the email must be on the Staff tab.
ALLOWED_DOMAIN=mtvernon.church
